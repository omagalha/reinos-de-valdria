{
  "name": "reinos-de-valdria-v4-19",
  "private": true,
  "version": "4.19.0",
  "type": "module",
  "description": "Jogo legado preservado e fundação TypeScript/Phaser para a evolução segura de Reinos de Valdria.",
  "scripts": {
    "generate": "npm run generate:legacy && npm run generate:map",
    "generate:legacy": "node scripts/generate-legacy-content.mjs",
    "generate:map": "node scripts/generate-fields-map.mjs",
    "predev": "npm run generate",
    "dev": "vite --host 0.0.0.0",
    "predev:lab": "npm run generate",
    "dev:lab": "vite --host 0.0.0.0 --open /modern.html",
    "prebuild": "npm run generate",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pretest": "npm run generate",
    "test": "npm run test:parity && npm run test:smoke && npm run test:foundation",
    "test:parity": "node scripts/verify-parity.mjs",
    "test:smoke": "vitest run tests/game-smoke.test.js",
    "test:foundation": "vitest run tests/foundation",
    "test:e2e": "playwright test",
    "check:full": "npm run check && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "verify:repos": "node scripts/verify-repositories.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:map": "node scripts/verify-fields-map.mjs",
    "check": "npm test && npm run typecheck && npm run verify:repos && npm run verify:assets && npm run verify:map && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "howler": "^2.2.4",
    "phaser": "^3.90.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/howler": "^2.2.13",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
